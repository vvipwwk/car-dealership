<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="NavigationCust.master.cs" Inherits="CarDealership.NavigationCust" %>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CarImport.my</title>
    <link rel="stylesheet" href="Site.css" />
    <asp:ContentPlaceHolder ID="head" runat="server" />
</head>
<body>
    <form id="form1" runat="server">
        <header class="site-header">
            <a class="brand-mark" href="CustHome.aspx">CarImport<span>.my</span></a>
            <div class="header-actions">
                <span class="welcome-text">Welcome, <asp:Label ID="lblusername" runat="server" /></span>
                <asp:Button ID="btnLogOut" runat="server" CssClass="btn btn-secondary btn-small" OnClick="btnLogOut_Click" Text="Log out" />
            </div>
        </header>
        <main class="site-body">
            <div class="site-layout">
                <aside class="site-nav">
                    <p class="nav-heading">Customer menu</p>
                    <asp:TreeView ID="TreeView1" runat="server" CssClass="nav-tree" DataSourceID="SiteMapDataSource1" ImageSet="Arrows" NodeIndent="8">
                        <HoverNodeStyle ForeColor="#d9783d" />
                        <NodeStyle Font-Names="Segoe UI, Arial" Font-Size="10pt" ForeColor="#334553" HorizontalPadding="5px" NodeSpacing="4px" VerticalPadding="5px" />
                        <SelectedNodeStyle Font-Bold="True" ForeColor="#142b3b" />
                    </asp:TreeView>
                    <asp:SiteMapDataSource ID="SiteMapDataSource1" runat="server" SiteMapProvider="SiteMap1" />
                </aside>
                <section class="content-panel"><asp:ContentPlaceHolder ID="ContentPlaceHolder2" runat="server" /></section>
            </div>
        </main>
        <footer class="site-footer">CarImport.my · Find your next drive</footer>
    </form>
</body>
</html>
